<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:DepartmentResourcesApp.Models"
             x:Class="DepartmentResourcesApp.MainPage"
             Title="Інформаційні ресурси кафедри (Варіант 7)">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" RowSpacing="12">

        <HorizontalStackLayout Grid.Row="0" Spacing="10">
            <Button Text="Відкрити XML"
                    Clicked="OnOpenXmlClicked"
                    BackgroundColor="#2563EB"
                    TextColor="White" />
            <Button Text="Перетворити XML у HTML"
                    Clicked="OnTransformHtmlClicked"
                    BackgroundColor="#059669"
                    TextColor="White" />
            <Button Text="Очистити"
                    Clicked="OnClearClicked"
                    BackgroundColor="#6B7280"
                    TextColor="White" />
            <Button Text="Довідка"
                    Clicked="OnHelpClicked" />
            <Button Text="Про програму"
                    Clicked="OnAboutClicked" />
            <Button Text="Вихід"
                    Clicked="OnExitClicked"
                    BackgroundColor="#DC2626"
                    TextColor="White" />
        </HorizontalStackLayout>

        <Border Grid.Row="1" Stroke="#CBD5E1" StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 8">
            <Grid ColumnDefinitions="*,*,*,*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="8">

                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                    <Label Text="Метод аналізу XML:" FontAttributes="Bold" FontSize="12" />
                    <Picker x:Name="StrategyPicker"
                            SelectedIndexChanged="OnStrategyChanged" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                    <Label Text="Тип ресурсу (вузол):" FontAttributes="Bold" FontSize="12" />
                    <Picker x:Name="ElementPicker" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="0" Grid.Column="2" Spacing="4">
                    <Label Text="Атрибут пошуку:" FontAttributes="Bold" FontSize="12" />
                    <Picker x:Name="AttributeNamePicker"
                            SelectedIndexChanged="OnAttributeNameChanged" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="0" Grid.Column="3" Spacing="4">
                    <Label Text="Значення атрибута:" FontAttributes="Bold" FontSize="12" />
                    <Picker x:Name="AttributeValuePicker" />
                </VerticalStackLayout>

                <Button Grid.Row="0" Grid.Column="4"
                        Text="Пошук"
                        VerticalOptions="End"
                        Clicked="OnSearchClicked"
                        BackgroundColor="#1D4ED8"
                        TextColor="White"
                        WidthRequest="120" />

                <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="5" Spacing="4">
                    <Label Text="Ключове слово (назва, автор, анотація, кафедра, адреса):" FontAttributes="Bold" FontSize="12" />
                    <Entry x:Name="KeywordEntry"
                           Placeholder="Введіть текст для додаткової фільтрації..." />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <CollectionView Grid.Row="2" x:Name="ResultsCollectionView">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="24">
                    <Label Text="Завантажте XML-файл та натисніть «Пошук» для відображення ресурсів кафедри."
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ResourceRecord">
                    <Border Stroke="#E2E8F0" StrokeThickness="1" Margin="0,0,0,8" Padding="12" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding DisplayTitle}" FontSize="16" FontAttributes="Bold" />
                            <Label Text="{Binding DisplaySubtitle}" FontSize="13" TextColor="#2563EB" />
                            <Label Text="{Binding DisplayDetails}" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="3"
               x:Name="StatusLabel"
               Text="Готово до роботи. Оберіть XML-файл."
               FontSize="12"
               TextColor="#475569" />
    </Grid>
</ContentPage>
